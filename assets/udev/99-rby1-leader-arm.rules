# RB-Y1 leader arm (FTDI FT232H, serial FT62AJW7), see docs/teleop_guide.md.
# 1) Stable device name /dev/rby1_leader_arm for the leader arm's tty.
SUBSYSTEM=="tty", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6014", ATTRS{serial}=="FT62AJW7", SYMLINK+="rby1_leader_arm"
# 2) FTDI latency_timer 1 ms (default 16 ms) for this adapter only. The attribute is on the usb-serial
#    device (ttyUSB*); vendor, product and serial are matched on its parent USB device (ATTRS).
ACTION=="add", SUBSYSTEM=="usb-serial", DRIVER=="ftdi_sio", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6014", ATTRS{serial}=="FT62AJW7", ATTR{latency_timer}="1"
